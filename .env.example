# SMTP van je eigen mailbox. Kopieer naar .env.local voor lokaal testen,
# en naar /etc/fynnworks.env op de Pi (chmod 600).
SMTP_HOST=smtp.hostnet.nl
SMTP_PORT=587
SMTP_USER=info@fynnworks.nl
SMTP_PASS=<wachtwoord van de mailbox>
# Waar de aanvragen naartoe gaan (mag hetzelfde adres zijn als SMTP_USER).
CONTACT_TO=info@fynnworks.nl
# Wachtwoord voor /admin. Zelf verzinnen, lang en uniek — dit is het enige slot
# op de beheerpagina. Wijzig je hem, dan zijn alle openstaande sessies meteen
# ongeldig.
ADMIN_PASSWORD=<verzin een lang wachtwoord>
# Alleen voor `next dev`: het LAN-adres van je pc, nodig om de dev-server op je
# telefoon te bekijken. Laat leeg als je alleen op localhost werkt.
DEV_ORIGIN=
