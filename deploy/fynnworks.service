[Unit]
Description=fynnworks website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fynn
WorkingDirectory=/srv/fynnworks
# Bevat SMTP_PASS — chmod 600, eigenaar root.
EnvironmentFile=/etc/fynnworks.env
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 3000
Restart=always
RestartSec=5
# Caddy is de enige die erbij hoeft.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/fynnworks/.next

[Install]
WantedBy=multi-user.target
