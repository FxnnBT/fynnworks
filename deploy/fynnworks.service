[Unit]
Description=fynnworks website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/srv/fynnworks
# Bevat SMTP_PASS — chmod 600, eigenaar root.
EnvironmentFile=/etc/fynnworks.env
Environment=NODE_ENV=production
Environment=PORT=3500
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 3500
Restart=always
RestartSec=5
# next reageert netjes op SIGTERM en eindigt met 143; zonder dit meldt systemd
# elke stop als "Failed with result 'exit-code'".
SuccessExitStatus=143
# Caddy is de enige die erbij hoeft.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/fynnworks/.next
# Projecten, reviews en uploads: systemd maakt /var/lib/fynnworks aan, zet
# $STATE_DIRECTORY, en houdt 'm schrijfbaar ondanks ProtectSystem=strict. Ligt
# buiten /srv/fynnworks, dus de tar-overdracht en een rebuild raken 'm niet.
StateDirectory=fynnworks

[Install]
WantedBy=multi-user.target
